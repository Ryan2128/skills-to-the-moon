{
	"name": "skills-to-the-moon",
	"version": "0.1.0",
	"description": "Self-hosted feedback loops for Agent skills: report corrections, monitor usage, open upgrade PRs, and sync skills locally.",
	"private": false,
	"type": "module",
	"packageManager": "pnpm@10.18.3",
	"keywords": [
		"ai-agent",
		"agent-skills",
		"feedback-loops",
		"agent",
		"skills",
		"self-hosted",
		"automation",
		"developer-tools",
		"codex",
		"skill-management",
		"fastify",
		"sqlite"
	],
	"homepage": "https://github.com/Ryan2128/skills-to-the-moon#readme",
	"bugs": {
		"url": "https://github.com/Ryan2128/skills-to-the-moon/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Ryan2128/skills-to-the-moon.git"
	},
	"license": "MIT",
	"files": [
		"bin/",
		"docs/",
		"dist/",
		"scripts/",
		"skills/",
		"src/",
		"templates/",
		"LICENSE",
		"README.md"
	],
	"bin": {
		"skills-to-the-moon": "bin/skills-to-the-moon.mjs"
	},
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "tsx watch src/server/index.ts",
		"build": "tsc -p tsconfig.json",
		"start": "node dist/src/server/index.js",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"package:feedback-rules": "node scripts/package-feedback-rules.mjs",
		"validate:feedback-skill": "node scripts/validate-feedback-skill.mjs"
	},
	"dependencies": {
		"better-sqlite3": "^12.10.0",
		"fastify": "^5.8.5",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^25.9.2",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"better-sqlite3",
			"esbuild"
		]
	}
}
